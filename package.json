{
  "name": "the-cut-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "tsc -b && vite build && playwright test",
    "format": "prettier --write src e2e *.ts *.js *.json",
    "art:optimize": "node scripts/optimize-art.mjs && node scripts/build-question-diagrams.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
